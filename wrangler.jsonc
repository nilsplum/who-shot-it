// Cloudflare deployment of Who Shot It?: one Worker (src/worker.js) that is the server
// of both store apps (API, room sockets, photos) and serves the website from web/ (in a
// browser the app's page shows the invite page; /legal the legal texts). Every room is
// its own Durable Object (src/room.js), stored in the EU (SERVER.jurisdiction).
// Everything runs on the Workers Free plan (SQLite-backed Durable Objects only).
// The top level is production; `env.staging` (below) is the same Worker a second time, for
// the test builds. The two are ENVIRONMENTS in web/shared/config.js (their Worker names and
// addresses pinned to this file by test/unit/config.test.js).
// `./scripts/deploy.sh staging|production` deploys one of them; `./scripts/dev.sh` and the
// tests run the top level locally. Each deploy also gives the Worker its version gate (which
// app versions may play, the newest out) as the value GATE: never in this file, the deploy
// asks for it starting from what the live server serves (normalizeGate in web/shared/config.js).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "who-shot-it",
  "main": "src/worker.js",
  // Newest date the pinned runtime supports; raise it together with wrangler.
  "compatibility_date": "2026-11-15",
  // The stylesheet web/css/app.css is built from styles/app.css and the classes in the
  // pages (Tailwind) before every `wrangler dev` and `wrangler deploy`, and again while
  // `wrangler dev` runs whenever one of these sources changes.
  "build": {
    "command": "scripts/helpers/styles.sh",
    "watch_dir": ["styles", "web/js", "web/index.html", "web/legal.html"]
  },
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    // Unknown paths serve index.html, so an invite link https://<server>/<CODE> shows the invite page.
    "not_found_handling": "single-page-application",
    // Only the API runs the Worker; every other file is served directly by Cloudflare.
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // A Durable Object class is registered once; never edit or remove a deployed migration.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // The public address, ENVIRONMENTS.production.origin in web/shared/config.js (pinned by a
  // test): for now the account's https://who-shot-it.<subdomain>.workers.dev. To move to a
  // domain (a zone in the same Cloudflare account), add  "routes": [{ "pattern": "whoshot.it", "custom_domain": true }]
  // and change the origin. The apps have the address built in, so keep workers_dev on
  // until no installed app uses the old address any more (README, Release). The Worker's
  // name ("who-shot-it") is part of that address: never rename it.
  "workers_dev": true,
  // No preview links per upload: every version would be a second public copy of the game.
  "preview_urls": false,
  // No stored request logs (privacy policy: we store no logs). `npx wrangler tail` streams live.
  "observability": { "enabled": false },
  // No Wrangler usage telemetry from the deploy machine.
  "send_metrics": false,
  "env": {
    // Staging, for the test builds (ENVIRONMENTS.staging): Wrangler deploys it as the Worker
    // "who-shot-it-staging" at its own workers.dev address, with everything above, but with
    // Durable Objects of its own, so its rooms and photos never meet production's. Wrangler
    // does not inherit the Durable Object binding, so it is repeated here, and so is its
    // migration, to state the same history for both.
    "staging": {
      "durable_objects": {
        "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
    }
  }
}
